# ==================================================================
# Skansaba.dev — Environment untuk Docker Compose
# Copy file ini jadi .env di server, sesuaikan nilainya.
# (File .env LARAVEL tidak perlu dibuat manual — entrypoint yang generate)
# ==================================================================

# Port web yang di-expose di host (misal: 80, 8000, 8080)
APP_PORT=8000

# User/group di host untuk permission file (id -u / id -g)
WWWUSER=1000
WWWGROUP=1000

# Database
DB_DATABASE=skansaba
DB_USERNAME=skansaba
DB_PASSWORD=gantiPasswordIni
DB_ROOT_PASSWORD=gantiRootPasswordIni
